
target/
src-tauri/target/
**/*.rs.bk

src-tauri/gen/
src-tauri/bindings/
src-tauri/.cargo/
# Prevent accidental re-commit of workflow example zips inside src-tauri/
src-tauri/*.zip

node_modules/
# dist/ is intentionally committed (Tauri reads compiled frontend assets from it at runtime).
# See CONTRIBUTING.md — do NOT add a bare `dist/` rule here.
# Only ignore generated sourcemaps to keep the diff clean.
dist/**/*.map
build/
.vite/
.npm/
.cache/


npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.env
.env.*
!.env.example
*.key
*.pem
*.crt
.cred.key

.DS_Store
Thumbs.db
desktop.ini


.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.code-workspace


*.exe
*.msi
*.dll
*.so
*.dylib
*.app
*.dmg
*.deb
*.rpm

# Bundled Node runtime, fetched by scripts/fetch-node-binaries.sh. Linux/macOS
# binaries have no extension, so the *.exe rule above doesn't catch them.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep


*.log
*.tmp
*.temp
*.swp

*.db
*.sqlite
*.sqlite3

coverage/
out/

patch_staging/

# Patch manifests written by fix batches; not part of the project.
MANIFEST.txt
