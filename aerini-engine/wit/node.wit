package aerini:plugin@0.1.0;

interface types {
    /// A key-value parameter passed to a node.
    record param {
        key: string,
        value: string,
    }

    /// Input passed to a plugin node's execute function.
    record node-input {
        /// Node configuration parameters (from the workflow JSON), one `param`
        /// per top-level key. A non-string value is JSON-encoded into `value`
        /// (e.g. a nested object becomes its JSON text), which requires
        /// re-parsing per field to recover structure. The host also always
        /// includes one additional entry, key "__aerini_input_json", whose
        /// value is the entire merged input JSON-encoded as a single object --
        /// parse that once instead of re-parsing individual fields. Skipped
        /// (with a host-side warning) on the rare chance a node's own config
        /// already defines a field with that literal name, so a plugin never
        /// receives host-synthesized data silently standing in for the
        /// author's own value.
        params: list<param>,
        /// Resolved credential values (secrets, never credential IDs).
        credentials: list<param>,
    }

    /// Output returned from a plugin node's execute function.
    record node-output {
        success: bool,
        /// JSON-encoded output data. Must be a valid JSON object string.
        data: string,
        /// Short machine-readable error code. Empty string if success.
        error-code: string,
        /// Human-readable error message. Empty string if success.
        error-message: string,
        /// If true, the executor may retry this node per its RetryPolicy.
        recoverable: bool,
    }

    /// Metadata describing this node type. Returned by describe().
    record node-descriptor {
        /// Unique identifier. Use reverse-domain format: "com.example.my-node"
        type-id: string,
        /// Display name shown in the UI palette.
        display-name: string,
        /// Category for palette grouping: "action", "ai", "logic", "utility"
        category: string,
        /// Short description shown in the UI.
        description: string,
        /// JSON Schema string for node inputs (shown in config panel).
        input-schema: string,
        /// JSON Schema string for node outputs (used in expression picker).
        output-schema: string,
    }
}

/// The interface every Aerini plugin node must implement.
interface node {
    use types.{node-input, node-output, node-descriptor};

    /// Return metadata about this node type. Called once at load time.
    describe: func() -> node-descriptor;

    /// Execute the node. Called for every workflow run that reaches this node.
    execute: func(input: node-input) -> node-output;
}

/// The world exported by every Aerini plugin component.
///
/// WASI imports (HTTP, filesystem, logging, etc.) are NOT declared here.
/// They are provided automatically by:
///   - the wasm32-wasip2 target on the plugin author's side
///   - wasmtime-wasi added to the Linker on the host side
/// Declaring WASI imports here would require wit/deps/ management with no benefit.
/// This world only declares what is specific to Aerini.
world aerini-node {
    export node;
}

/// Optional plugin identity/branding metadata. Not required -- deliberately
/// kept out of the `aerini-node` world so plugins compiled against any
/// earlier revision of this package keep loading unchanged. A plugin that
/// does not export this interface gets host-side defaults: no icon (generic
/// glyph), empty author, "1.0.0" version.
interface metadata {
    record plugin-metadata {
        /// Semver string, e.g. "1.2.0". Empty string -> host defaults to "1.0.0".
        version: string,
        /// Author or organization name shown in the plugin's detail view. Empty string if unset.
        author: string,
        /// Icon markup: zero or more SVG shape elements only -- <path>, <circle>,
        /// <rect>, <line>, <ellipse>, <polygon>, <polyline>, <g> -- no <script>,
        /// <style>, <foreignObject>, <image>, <use>, <a>, event-handler attributes,
        /// or a `style` attribute. Rendered inside a fixed 24x24 viewBox, stroke-only,
        /// single theme-driven color -- matching the built-in node icon style exactly.
        /// Anything outside this allowlist is stripped by the host before rendering
        /// (see docs/plugin-authoring.md). Empty string -> generic plugin glyph.
        icon: string,
    }

    describe-metadata: func() -> plugin-metadata;
}

/// Extends `aerini-node` with the optional `metadata` export. Plugin authors who
/// want a custom icon/author/version target THIS world when generating guest
/// bindings, instead of `aerini-node`. Old plugins built against `aerini-node`
/// (with or without `metadata` existing in this file) keep loading unchanged --
/// the host tries this world's shape and falls back to plain `aerini-node`.
world aerini-node-with-metadata {
    export node;
    export metadata;
}

/// Optional trigger-plugin interface. A plugin exporting this alongside `node`
/// can act as a trigger source: instead of running once per workflow
/// execution like `node.execute`, the host keeps one instance alive and reads
/// a stream of events from it, each one starting a new workflow run.
///
/// Every other function in this package is synchronous; `events` is not -- it
/// requires an async-capable host runtime (WASI 0.3 / Preview 3
/// component-model-async). An engine configured for synchronous calls cannot
/// also host an async one and vice versa, so a plugin exporting both `node`
/// and `trigger` is instantiated separately per role, on two different
/// wasmtime engines.
interface trigger {
    /// One event produced by a trigger's `events` stream.
    record trigger-event {
        /// JSON-encoded event payload. Must be a valid JSON object string --
        /// becomes the input to the workflow run this event starts.
        data: string,
    }

    /// Begin emitting trigger events. Unlike `node.execute` -- called once per
    /// workflow run -- `events` is called once per running trigger-plugin
    /// instance, at trigger-registration time; its returned stream stays open
    /// and is drained for that instance's whole lifetime.
    ///
    /// `config` is the trigger node's resolved configuration (the values a
    /// workflow author sets in its config panel, `{{...}}` expressions
    /// already evaluated), JSON-encoded as a single object string -- parsed
    /// once, with nested objects/arrays intact. `node-input.params` instead
    /// carries values as a flat list because it must stay compatible with
    /// already-published plugins built against that exact shape; this
    /// interface has no such history, so it takes the single-JSON-string form
    /// directly.
    events: async func(config: string) -> stream<trigger-event>;
}

/// Extends `aerini-node` with the optional `trigger` export, additive in the
/// same way `aerini-node-with-metadata` is. Old plugins targeting
/// `aerini-node` or `aerini-node-with-metadata` keep loading unchanged --
/// this world is an addition, not a replacement.
world aerini-node-with-trigger {
    export node;
    export trigger;
}

/// `aerini-node-with-trigger` plus the optional `metadata` export, for a trigger
/// plugin that wants a custom icon/author/version. Target THIS world instead of
/// `aerini-node-with-trigger` to get them; a trigger plugin built against
/// `aerini-node-with-trigger` keeps loading unchanged and gets the host
/// defaults described on `interface metadata`. Additive, like every other
/// world in this package.
world aerini-node-with-trigger-and-metadata {
    export node;
    export trigger;
    export metadata;
}

/// Optional, host-provided hint about when a trigger plugin's next event is
/// due, so the Background Runs panel can show a "next in Ns" countdown.
/// Like `storage` and `fs-watch`, this is an IMPORT the host links
/// unconditionally: a plugin built before it existed has no such import and
/// is unaffected (it simply shows plain "running"), and no existing
/// interface, record or world changes shape.
///
/// It is an import, not a query, because only the running `trigger.events`
/// instance knows its own timer -- the instance `node.execute` runs on is a
/// separate one that cannot see it. The running instance calls
/// `report-next-fire` whenever it arms or re-arms its timer.
interface trigger-schedule {
    /// Reports when the next event is expected, in milliseconds since the
    /// Unix epoch (UTC). Advisory only: it never changes when the host runs
    /// anything. The host ignores a value that is already past, more than a
    /// year ahead, or earlier than the last event it received, and it may
    /// coalesce rapid calls, so report once each time the timer is armed, and
    /// again after each event for the following one. Never traps and never
    /// blocks.
    report-next-fire: func(unix-ms: u64);
}

/// `aerini-node-with-trigger` plus the `trigger-schedule` import. Target THIS
/// world to report next-fire times; plugins built against
/// `aerini-node-with-trigger` keep loading unchanged. A trigger plugin that
/// wants `metadata` as well hand-declares its own world exporting `node`,
/// `trigger` and `metadata` and importing `trigger-schedule`, the same way
/// `storage` and `fs-watch` combine with other worlds.
world aerini-node-with-trigger-and-next-fire {
    export node;
    export trigger;
    import trigger-schedule;
}

/// Optional, host-provided key-value storage. Unlike `metadata`/`trigger`
/// above (things a plugin *exports* for the host to call), `storage` is an
/// *import* -- something the host provides for a plugin to call -- so it
/// carries no combinability problem with the other optional capabilities:
/// a plugin author who also wants `metadata` or `trigger` alongside
/// `storage` can hand-declare their own world importing `storage` next to
/// whichever export(s) they need; the host links `storage` into every
/// plugin's linker unconditionally (see `plugin_loader.rs`), so it is
/// available regardless of which of this package's worlds a given plugin
/// actually targets.
///
/// Scoped per plugin **type-id**, not per placed node instance -- every
/// execution of a given plugin, across every workflow and every
/// placement, reads and writes the same key space. Bounded: hosts reject
/// oversized keys/values and enforce a total-bytes quota per plugin (see
/// `plugin_loader.rs`'s `STORAGE_MAX_*` constants for current limits) --
/// this is a small durable-notes capability, not a general-purpose
/// database or a substitute for the Database/S3 nodes.
///
/// Only backed by a real store during `node.execute` -- during `describe()`
/// (called once at load time, before a plugin's own type-id is even known,
/// which is what `storage` would otherwise be scoped by) every function
/// here is a no-op: `get` returns `none`, `set`/`list-keys` return
/// `error(unavailable)`, `delete` does nothing.
interface storage {
    /// Failure reasons for `set`/`list-keys`. `get` and `delete` never
    /// fail -- a storage-backend problem there degrades to "key absent" /
    /// "nothing to delete" respectively (logged host-side), not a guest
    /// error, since neither can lose data the guest hasn't already
    /// confirmed was written via a successful `set`.
    enum storage-error {
        /// `key` exceeded the host's max key length.
        key-too-long,
        /// `value` exceeded the host's max value length.
        value-too-large,
        /// This plugin's total stored bytes, or total key count, would
        /// exceed its quota.
        quota-exceeded,
        /// The storage backend itself is unavailable (e.g. couldn't be
        /// opened, or a working connection couldn't be obtained) --
        /// unrelated to `key`/`value` content.
        unavailable,
    }

    /// Fetch a value by key. Returns `none` if the key doesn't exist --
    /// or, per this interface's own doc comment, if the storage backend
    /// hit a problem reading it.
    get: func(key: string) -> option<string>;

    /// Store `value` under `key`, overwriting any existing value for that
    /// key.
    set: func(key: string, value: string) -> result<_, storage-error>;

    /// Delete `key`. Not an error if the key didn't exist.
    delete: func(key: string);

    /// List every stored key that starts with `prefix` (an empty `prefix`
    /// lists every key for this plugin), lexicographically sorted.
    list-keys: func(prefix: string) -> result<list<string>, storage-error>;
}

/// Pairs `storage` with the required `node` export -- the convenience
/// world plugin authors compiling against this package's `wit-bindgen`/
/// `bindgen!` tooling target when they want storage. Additive alongside
/// `aerini-node`/`aerini-node-with-metadata`/`aerini-node-with-trigger`;
/// old plugins targeting any of those keep loading unchanged.
world aerini-node-with-storage {
    export node;
    import storage;
}

/// Optional, host-provided filesystem watching. Like `storage`, this is an
/// *import*: real OS-level watching (via the host's `notify` crate) runs
/// continuously in the host process, independent of any single `execute()`
/// call's ephemeral, sandboxed Store -- the same reason `storage`'s backing
/// database outlives the Store that calls into it (see `plugin_loader.rs`'s
/// module doc comment, "Plugins cannot access the real filesystem"). This is
/// what makes a working file-watcher plugin possible at all: the sandbox
/// denies a plugin the real filesystem outright, so a plugin cannot watch
/// anything itself -- it can only ask the host to watch on its behalf and
/// report back what changed.
///
/// Deliberately synchronous, not `trigger`'s `async func` shape: `poll` is
/// called from inside a normal `execute()` call, the same way any other
/// action node works today -- typically driven by a Schedule node polling on
/// an interval -- rather than depending on `trigger.events()`'s host-side
/// event pump, which has open bugs and does not yet deliver events end to
/// end (see `docs/development/plugin-authoring.md`). A plugin built against
/// this interface works today; nothing here depends on that bug being fixed.
interface fs-watch {
    /// One request to watch (or continue watching) a path.
    record watch-target {
        /// Absolute path to a file or directory. A relative path is
        /// rejected with `invalid-config` -- the host has no concept of
        /// "the plugin's working directory" to resolve one against.
        path: string,
        /// Watch `path` and everything below it, not just its immediate
        /// contents. Ignored (treated as false) when `path` is a file.
        recursive: bool,
        /// Which event kinds this call wants back: any of "created",
        /// "modified", "deleted", "renamed". Rejected with `invalid-config`
        /// if empty or if any entry isn't one of those four -- there is no
        /// implicit "all events" default.
        events: list<string>,
    }

    /// One filesystem change, already resolved to plain, stable fields -- a
    /// plugin never sees a raw platform-native notification kind.
    record fs-event {
        /// One of "created", "modified", "deleted", "renamed" -- always a
        /// member of the `events` list the caller's `watch-target` asked
        /// for; the host never returns a kind the caller didn't request.
        event-type: string,
        /// Absolute path the event is about. For "renamed", this is the
        /// file's new path.
        path: string,
        /// Previous absolute path -- only set (non-empty) for "renamed".
        previous-path: string,
        /// File or directory name (final path component).
        name: string,
        /// Lowercase extension without the leading dot, or empty string if
        /// the name has none.
        extension: string,
        /// Size in bytes at the moment the host observed the event. 0 for
        /// "deleted" (the file no longer exists to stat) and for a
        /// directory.
        size: u64,
        /// True if the path is a directory.
        is-directory: bool,
        /// RFC 3339 timestamp the host observed and coalesced this event at
        /// -- not the filesystem's own ctime/mtime, which some platforms
        /// don't expose per-event at all.
        observed-at: string,
    }

    /// Why a `poll` call returned no events, or failed outright.
    enum watch-error {
        /// `path` does not exist (nothing to watch).
        path-not-found,
        /// The host process does not have permission to read `path`.
        permission-denied,
        /// `path` was relative, or `events` was empty or contained an
        /// unrecognised value.
        invalid-config,
        /// This plugin type-id already has as many distinct active targets
        /// as the host allows, and `target` would be a new one.
        quota-exceeded,
        /// The host could not start or continue a real OS-level watch for
        /// this target (e.g. a platform watch-descriptor limit was hit) --
        /// unrelated to `target`'s own content.
        unavailable,
    }

    /// Result of one `poll` call.
    record poll-result {
        /// Every event observed for this exact target since the last
        /// successful `poll` call for it (or since the watch started, on
        /// the first call), oldest first. Bounded: the host buffers only so
        /// many events per target between polls.
        events: list<fs-event>,
        /// True if the buffer above was full and the host had to drop the
        /// oldest events to make room for newer ones before this poll
        /// drained it -- some events between the last poll and this one
        /// were lost. `events` is never silently incomplete without this
        /// being set.
        overflowed: bool,
    }

    /// Ensure a host-side watch is running for `target` -- starting one if
    /// this is the first `poll` for it, otherwise reusing the already-
    /// running watch -- and return every event buffered for it since the
    /// last call, draining the buffer. Two calls are the "same target" when
    /// `path` (after canonicalizing), `recursive`, and the exact contents of
    /// `events` all match; changing any of them starts a distinct watch
    /// rather than reconfiguring the existing one -- the old one keeps
    /// running until `unwatch` is called for it or it is reaped for
    /// inactivity (see `unwatch`'s doc comment).
    ///
    /// Watches are scoped per plugin type-id, like `storage` -- every
    /// execution of a given plugin, across every workflow and every
    /// placement, that calls `poll` with an equivalent `target` shares the
    /// same underlying watch and buffer.
    poll: func(target: watch-target) -> result<poll-result, watch-error>;

    /// Stop the host-side watch for `target` (exact match on
    /// `path`/`recursive`/`events`, same equivalence `poll` uses) and
    /// discard its buffered events. Not an error if no such watch is
    /// running. A watch nobody has polled for long enough is stopped
    /// automatically the same way; calling this explicitly (e.g. when a
    /// workflow author disables a watcher node) just frees the underlying
    /// OS resource sooner.
    unwatch: func(target: watch-target);
}

/// Pairs `fs-watch` with the required `node` export -- the convenience world
/// plugin authors compiling against this package's tooling target when they
/// want filesystem watching, exactly as `aerini-node-with-storage` does for
/// `storage`. Additive alongside every other world in this package; old
/// plugins targeting any of them keep loading unchanged. A plugin author who
/// wants `fs-watch` alongside `storage`, `metadata`, or `trigger` hand-
/// declares their own world importing/exporting whichever combination they
/// need -- same guidance `storage`'s own doc comment gives.
world aerini-node-with-fs-watch {
    export node;
    import fs-watch;
}
