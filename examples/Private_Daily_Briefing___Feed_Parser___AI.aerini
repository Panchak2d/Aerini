{
  "schema_version": "1.0",
  "id": "private-daily-briefing-feed-parser-ai-2611011101",
  "name": "Private Daily Briefing (Feed Parser + AI)",
  "description": "Every morning: fetch an RSS or Atom feed, keep only the newest item not seen before, have a local model summarize it in two sentences, append the summary to a text file and show a notification. A day with nothing new adds a one-line log entry and no notification. If the fetch or the model fails, you get an alert, and a failed summary is saved without text so the item is not lost. No Code node, no cloud AI.",
  "nodes": [
    {
      "id": "daily",
      "node_type_id": "schedule",
      "node_type": "action",
      "name": "Every Morning",
      "config": {
        "mode": "cron",
        "cron_expr": "0 8 * * *"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 0.0,
        "y": 120.0
      }
    },
    {
      "id": "fetch",
      "node_type_id": "http_request",
      "node_type": "action",
      "name": "Fetch Feed",
      "config": {
        "method": "GET",
        "url": "https://example.com/feed.xml"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 3,
        "backoff_ms": 2000
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 340.0,
        "y": 120.0
      }
    },
    {
      "id": "feed",
      "node_type_id": "feed_parser",
      "node_type": "utility",
      "name": "Newest Item",
      "config": {
        "text": "{{Fetch Feed.output.body}}",
        "base_url": "https://example.com/feed.xml",
        "only_new": true,
        "on_first_run": "baseline",
        "max_items": 1
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 680.0,
        "y": 120.0
      }
    },
    {
      "id": "any",
      "node_type_id": "if_condition",
      "node_type": "logic",
      "name": "Anything New",
      "config": {
        "condition": "{{Newest Item.output.count}} > 0"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1020.0,
        "y": 120.0
      }
    },
    {
      "id": "sum",
      "node_type_id": "ai_prompt",
      "node_type": "ai",
      "name": "Summarize",
      "config": {
        "provider": "local",
        "base_url": "http://localhost:11434/v1",
        "model": "llama3",
        "prompt": "Summarize this in two sentences:\n\nTitle: {{Newest Item.output.latest.title}}\nLink: {{Newest Item.output.latest.link}}\n\n{{Newest Item.output.latest.summary}}",
        "system": "You write one-item news briefings. Reply with exactly two plain sentences. No preamble, no quotes, no markdown, no commentary.",
        "temperature": 0.3,
        "timeout_secs": 600
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1360.0,
        "y": 120.0
      }
    },
    {
      "id": "log",
      "node_type_id": "file",
      "node_type": "action",
      "name": "Append to Briefing",
      "config": {
        "operation": "append",
        "path": "daily-briefing.txt",
        "content": "{{Newest Item.output.latest.title}}\n{{Summarize.output.content}}\n{{Newest Item.output.latest.link}}\n\n"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1700.0,
        "y": 120.0
      }
    },
    {
      "id": "note",
      "node_type_id": "notification",
      "node_type": "action",
      "name": "Notify Me",
      "config": {
        "title": "{{Newest Item.output.latest.title}}",
        "body": "{{Summarize.output.content}}"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 2040.0,
        "y": 120.0
      }
    },
    {
      "id": "quiet_log",
      "node_type_id": "file",
      "node_type": "action",
      "name": "Log Nothing New",
      "config": {
        "operation": "append",
        "path": "daily-briefing.txt",
        "content": "{{format_date($run.timestamp, \"YYYY-MM-DD\")}}: nothing new\n"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1360.0,
        "y": 420.0
      }
    },
    {
      "id": "quiet_out",
      "node_type_id": "output",
      "node_type": "utility",
      "name": "Nothing New",
      "config": {
        "label": "Result"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1700.0,
        "y": 420.0
      }
    },
    {
      "id": "done_out",
      "node_type_id": "output",
      "node_type": "utility",
      "name": "Briefing Done",
      "config": {
        "label": "Result"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 2380.0,
        "y": 120.0
      }
    },
    {
      "id": "fetch_alert",
      "node_type_id": "notification",
      "node_type": "action",
      "name": "Alert Fetch Failed",
      "config": {
        "title": "Briefing: could not fetch the feed",
        "body": "Today's briefing was skipped. Open the History tab for the error.",
        "urgency": "normal"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 340.0,
        "y": 420.0
      }
    },
    {
      "id": "fail_save",
      "node_type_id": "file",
      "node_type": "action",
      "name": "Save Unsummarized",
      "config": {
        "operation": "append",
        "path": "daily-briefing.txt",
        "content": "{{Newest Item.output.latest.title}}\n(summary failed, read it at the link)\n{{Newest Item.output.latest.link}}\n\n"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1360.0,
        "y": -200.0
      }
    },
    {
      "id": "fail_alert",
      "node_type_id": "notification",
      "node_type": "action",
      "name": "Alert Summary Failed",
      "config": {
        "title": "Briefing: summary failed",
        "body": "{{Newest Item.output.latest.title}} was saved to daily-briefing.txt without a summary. Is the local model running?",
        "urgency": "normal"
      },
      "credentials": {},
      "input_schema": {},
      "output_schema": {},
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 500
      },
      "fallback_node": null,
      "disabled": false,
      "position": {
        "x": 1700.0,
        "y": -200.0
      }
    }
  ],
