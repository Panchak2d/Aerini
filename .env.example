# Flowo Server — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: API token for authenticating requests (or pass --token on CLI)
FLOWO_TOKEN=your-secret-token-here

# Optional: port to bind the API server (default: 7700)
FLOWO_PORT=7700

# Optional: directory for storing workflows, credentials, and run history
FLOWO_DATA_DIR=~/.local/share/flowo

# Optional: log level (default: info)
# Valid values: error, warn, info, debug, trace
RUST_LOG=info
