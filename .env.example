# Aerini Server — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# docker compose reads only AERINI_TOKEN and AERINI_TRUSTED_PROXY_COUNT from
# this file; the port, data directory and log level are fixed in
# docker-compose.yml. When running the binary directly, export the optional
# variables below in your shell instead.

# Required by docker compose: API token for authenticating requests (or pass
# --token on the CLI). Must be at least 32 characters; the server exits
# otherwise. Generate one with: openssl rand -base64 32
AERINI_TOKEN=

# Optional: port to bind the API server (default: 7700)
AERINI_PORT=7700

# Optional: directory for the SQLite database and the token/credential key
# file (default: ~/.aerini-server)
# AERINI_DATA_DIR=~/.aerini-server

# Optional: number of reverse proxies in front of the server, such as Caddy or
# nginx (default: 0). Leave it at 0 only when nothing sits in front; behind
# one proxy set it to 1, or every client shares one rate-limit allowance.
# AERINI_TRUSTED_PROXY_COUNT=0

# Optional: log level (default: info)
# Valid values: error, warn, info, debug, trace
RUST_LOG=info
